# Copy to apps/web/.env.local for local development. Never commit real values.
# Origin the Next.js server uses to reach the Express API (server-side only, never sent to browsers).
# In development, /api/v1/* on the web origin is rewritten here so browser calls stay same-origin.
API_INTERNAL_ORIGIN=http://127.0.0.1:4100
# Public origin of the site (canonical and hreflang links).
PUBLIC_ORIGIN=http://localhost:3100
