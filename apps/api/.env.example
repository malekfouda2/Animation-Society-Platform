# Copy to apps/api/.env for local development. Never commit real values.
NODE_ENV=development
API_PORT=4100
# Bind address. Use 0.0.0.0 only inside a container behind the reverse proxy.
API_HOST=127.0.0.1
# Local single-node replica set from docker-compose.yml (transactions require a replica set).
MONGODB_URI=mongodb://127.0.0.1:27017/animation_society_dev?replicaSet=rs0&directConnection=true
# Public origin of the web app (used for CORS-free same-origin checks and links).
PUBLIC_ORIGIN=http://localhost:3100
LOG_LEVEL=info
# Integration modes. "mock" is development-only; production refuses to start with mock.
PAYMENT_MODE=mock
EMAIL_MODE=mock
# Society mailbox for contact-form messages (not yet supplied). Leave empty to store messages only.
# Development: a synthetic address so the message shows in the local inbox.
CONTACT_INBOX=society-inbox@example.test
# Uploaded images (relative to apps/api in development; persistent storage in production).
MEDIA_DIR=var/media
# Encrypts staff authenticator (MFA) secrets; keep it out of the database and backups of it.
# Generate: openssl rand -base64 32   (each environment gets its own key; losing it means re-enrolling staff MFA)
MFA_ENCRYPTION_KEY=
