# Copy to apps/api/.env for local development. Never commit real values.
NODE_ENV=development
API_PORT=4100
# Bind address. Use 0.0.0.0 only inside a container behind the reverse proxy.
API_HOST=127.0.0.1
# Local single-node replica set from docker-compose.yml (transactions require a replica set).
MONGODB_URI=mongodb://127.0.0.1:27017/animation_society_dev?replicaSet=rs0&directConnection=true
# Public origin of the web app (used for CORS-free same-origin checks and links).
PUBLIC_ORIGIN=http://localhost:3100
LOG_LEVEL=info
# Integration modes. "mock" is development-only; production refuses to start with mock.
PAYMENT_MODE=mock
EMAIL_MODE=mock
